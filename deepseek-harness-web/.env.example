# cp .env.example .env

API_KEY=

# --- 模型路由 ---
# 不设 BASE_URL：使用官方 DeepSeek（API_KEY 即 DeepSeek 密钥）
# 自定义 OpenAI 兼容网关（设置后必须同时提供 MODEL）：
# BASE_URL=https://gateway.example/v1
# MODEL=my-model-id             # 多个 id 用逗号分隔；第一个为默认模型

# --- 访问 ---
# PORT=3080
# 域名访问时的 Trusted Host（可带端口）
# TRUSTED_HOST=chat.example.com

# --- 工作区 ---
# 首次启动时在 /root 下预建的默认工作目录
# （方便 Web UI 目录选择器直接选用）
# WORKSPACE_DIR=default

# --- 日志 ---
# LOG_LEVEL=debug

# --- 监听地址（dsh 0.2+）---
# 不设则自动取容器 eth 的 IPv4；勿再写 0.0.0.0
# DSH_WEB_HOST=172.17.0.2
